# ---------------------------------------------------------------------------
# FORTIS — variables d'environnement
# Copiez ce fichier vers .env.local (DÉVELOPPEMENT UNIQUEMENT, jamais commité)
# ---------------------------------------------------------------------------

# URL publique du site, utilisée dans les emails et les QR codes des quittances.
APP_URL=http://localhost:3000

# Secret de signature des sessions administrateur (32 caractères minimum).
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Premier compte administrateur, créé par `npm run db:seed`.
ADMIN_NAME=Administration FORTIS
ADMIN_EMAIL=admin@fortis.example
ADMIN_PASSWORD=

# Envoi d'emails via Resend (https://resend.com).
# Sans clé, les emails sont écrits dans .emails/ en développement.
RESEND_API_KEY=
MAIL_FROM="FORTIS <onboarding@resend.dev>"
# Adresse supplémentaire notifiée à chaque nouvelle demande (optionnel).
ADMIN_NOTIFICATION_EMAIL=

# Base de données.
# Développement : fichier SQLite local (aucune installation nécessaire).
# Production : créez une base Turso et renseignez les deux variables.
TURSO_DATABASE_URL=file:./data/fortis.db
TURSO_AUTH_TOKEN=
