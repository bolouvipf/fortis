{
  "name": "fortis-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site officiel FORTIS — BTP, comptabilité, formation, commerce et quittances validées.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
